APP_ENV=development
APP_NAME=La Biblioteca de Alejandria API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://alejandria:alejandria_dev@localhost:5433/alejandria
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_API_KEY=
AI_CHAT_MODEL=gemini-3.8-flash
AI_EMBEDDING_MODEL=gemini-embedding-001
AI_EMBEDDING_DIMENSIONS=1536
AI_RETRY_ATTEMPTS=3
AI_RETRY_BACKOFF_SECONDS=1
AI_THINKING_BUDGET=0
EXTERNAL_API_TIMEOUT_SECONDS=8
EXTERNAL_API_USER_AGENT=BibliotecaAlejandria/0.1 (academic project)
# Requiere un contacto real, por ejemplo: BibliotecaAlejandriaBot/0.1 (URL; correo)
WIKIMEDIA_USER_AGENT=
RAG_CHUNK_SIZE=1800
RAG_CHUNK_OVERLAP=200
RAG_TOP_K=5
RAG_INDEX_BATCH_SIZE=20
